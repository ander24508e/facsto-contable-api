APP_NAME="FACSTO API"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8002
SANCTUM_STATEFUL_DOMAINS=localhost:5173
CORS_ALLOWED_ORIGINS=http://localhost:5173

APP_LOCALE=es
APP_FALLBACK_LOCALE=es
APP_FAKER_LOCALE=es_EC
APP_TIMEZONE=America/Guayaquil

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=facsto
DB_USERNAME=facsto
DB_PASSWORD=facsto_local

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_SECURE_COOKIE=false
SESSION_SAME_SITE=lax

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=private
QUEUE_CONNECTION=redis

CACHE_STORE=redis
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# SRI: versión XSD de factura (1.1.0, hasta 6 decimales), proveedor de software y transmisión.
SRI_INVOICE_XML_VERSION=1.1.0
SRI_SOFTWARE_PROVIDER_RUC=1720127180001
SRI_SOFTWARE_PROVIDER_NAME="Condore Software"
# true sólo cuando el SRI confirme el registro del proveedor (Resolución NAC-DGERCGC26-00000027).
SRI_SOFTWARE_PROVIDER_REGISTERED=false
# Interruptor global: mientras sea false, FACSTO nunca transmite al SRI.
SRI_TRANSPORT_ENABLED=false
# Firmador XAdES-BES (imagen Docker: /opt/facsto/xades-signer.jar).
SRI_SIGNER_JAR=/opt/facsto/xades-signer.jar
SRI_SIGNER_TIMEOUT=60
# Servicios web del SRI: tiempos de espera (s) y consulta de autorización.
SRI_CONNECT_TIMEOUT=10
SRI_TIMEOUT=30
SRI_AUTHORIZATION_DELAY=30
SRI_AUTHORIZATION_MAX_POLLS=10
SRI_STALE_AFTER_MINUTES=10
# Entrega por correo del comprobante autorizado. false = SKIPPED_SMTP_NOT_CONFIGURED (nunca se simula).
DELIVERY_EMAIL_ENABLED=false
